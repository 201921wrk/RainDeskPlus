{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RAINDOCK_BUILD_DOCK": "ON"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja (Debug)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja (Release)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 18 2026 (x64)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026"
    },
    {
      "name": "vs2026-x64-dock-ui",
      "displayName": "VS2026 x64 + Duilib",
      "inherits": "vs2026-x64",
      "binaryDir": "${sourceDir}/build/vs2026-dock-ui",
      "cacheVariables": { "RAINDOCK_USE_DUILIB": "ON" }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 17 2022 (x64) fallback",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022"
    },
    {
      "name": "vs2022-x64-dock-ui",
      "displayName": "VS2022 x64 + Duilib",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/build/vs2022-dock-ui",
      "cacheVariables": { "RAINDOCK_USE_DUILIB": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "ninja-debug",   "configurePreset": "ninja-debug" },
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "vs2026-debug",   "configurePreset": "vs2026-x64", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026-x64", "configuration": "RelWithDebInfo" },
    { "name": "vs2026-dock-ui-debug",   "configurePreset": "vs2026-x64-dock-ui", "configuration": "Debug" },
    { "name": "vs2026-dock-ui-release", "configurePreset": "vs2026-x64-dock-ui", "configuration": "RelWithDebInfo" },
    { "name": "vs2022-debug",   "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "vs2022-release", "configurePreset": "vs2022-x64", "configuration": "RelWithDebInfo" },
    { "name": "vs2022-dock-ui-debug",   "configurePreset": "vs2022-x64-dock-ui", "configuration": "Debug" },
    { "name": "vs2022-dock-ui-release", "configurePreset": "vs2022-x64-dock-ui", "configuration": "RelWithDebInfo" }
  ]
}
